# Copy to config.env and fill in. run-all.sh EXPORTS these, so every check
# subprocess sees them. Merely sourcing them was a real defect in an earlier
# version: every check reported SKIP and the suite could never go green.

AIOS_ROOT=/srv/aios
AIOS_DATA=$AIOS_ROOT/data
AIOS_CONF=$AIOS_ROOT/conf
AIOS_BIN=$AIOS_ROOT/bin
AIOS_SECRETS=$AIOS_ROOT/secrets
AIOS_SKILLS=$AIOS_CONF/skills

AIOS_CONTAINER=aios
AIOS_CONTAINER_USER=aios

# Your timezone, Region/City. Every schedule in these documents is local time
# and a fresh Hetzner box is UTC.
AIOS_TZ=

# HOST.1-3 probe from OUTSIDE this machine. Leave unset and they report SKIP,
# which scores as a failure, correctly: nobody has proven the port is shut.
# A tailnet device is NOT a valid vantage point.
AIOS_PUBLIC_IP=
AIOS_EXT_PROBE=

# The free-tier lane. See reference/R2-privacy-routing.md before setting these.
AIOS_FREE_KEY_FILE=$AIOS_SECRETS/free-tier-key
AIOS_FREE_MODEL=
